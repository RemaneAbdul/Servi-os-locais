# ==============================
# SERVIÇOS LOCAIS - ENVIRONMENT
# ==============================

# Database (server only)
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE

# Session signing secret (server only)
# Use a long random value in Vercel Production/Preview.
JWT_SECRET=replace-with-a-long-random-secret

# Existing Manus/OAuth integration (server only, if OAuth is used)
OAUTH_SERVER_URL=https://your-oauth-server.example
VITE_APP_ID=your-app-id
OWNER_OPEN_ID=your-owner-open-id

# Optional built-in API integration (server only)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Frontend API URL.
# Web production can stay empty because the app uses same-origin /api routes.
# Native builds should use the public URL of this deployed API.
EXPO_PUBLIC_API_BASE_URL=

# Existing OAuth frontend variables, if OAuth login is enabled
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# OAuth web callback destination, when needed
EXPO_WEB_PREVIEW_URL=
EXPO_PACKAGER_PROXY_URL=
